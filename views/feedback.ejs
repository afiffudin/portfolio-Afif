<section class="wrap form-page">
  <h1>Isi feedback</h1>
  <p class="lead">Ceritakan pengalaman Anda saat saya membantu. Penilaian akan tampil di halaman utama.</p>

  <form id="feedbackForm" class="form form-card">
    <label class="field"><span>Nama</span>
      <input type="text" name="name" class="input" autocomplete="name" required>
    </label>

    <label class="field"><span>Divisi</span>
      <input type="text" name="divisi" class="input" required>
    </label>

    <label class="field"><span>Dibantu untuk</span>
      <select name="service" class="input" required>
        <option value="">Pilih layanan…</option>
        <option value="Support system">Support system</option>
        <option value="Pengembangan web">Pengembangan web</option>
        <option value="Pengembangan aplikasi">Pengembangan aplikasi</option>
        <option value="DevOps">DevOps</option>
        <option value="Deploy sistem to hosting">Deploy sistem to hosting</option>
      </select>
    </label>

    <fieldset class="field">
      <legend class="legend">Rating</legend>
      <div class="stars">
        <input type="radio" id="star5" name="rating" value="5" required><label for="star5" title="5 bintang" aria-label="5 bintang">★</label>
        <input type="radio" id="star4" name="rating" value="4"><label for="star4" title="4 bintang" aria-label="4 bintang">★</label>
        <input type="radio" id="star3" name="rating" value="3"><label for="star3" title="3 bintang" aria-label="3 bintang">★</label>
        <input type="radio" id="star2" name="rating" value="2"><label for="star2" title="2 bintang" aria-label="2 bintang">★</label>
        <input type="radio" id="star1" name="rating" value="1"><label for="star1" title="1 bintang" aria-label="1 bintang">★</label>
      </div>
    </fieldset>

    <label class="field"><span>Keterangan</span>
      <textarea name="keterangan" class="input" placeholder="Tambahkan catatan atau komentar"></textarea>
    </label>

    <div><button type="submit" class="btn btn-primary">Kirim penilaian</button></div>
    <div id="feedbackMessage" class="status" role="status" aria-live="polite"></div>
  </form>
</section>

<script src="/js/feedback.js"></script>