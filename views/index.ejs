<%
  const works = [
    { href: '/portfolio/programming-mobile', img: '/images/Flutter1.png', alt: 'Tampilan aplikasi mobile Flutter',
      title: 'Programming Mobile',
      text: 'Aplikasi Android dan iOS dengan Flutter, lengkap dengan koneksi ke database.',
      stack: ['Flutter', 'Firebase', 'PostgreSQL', 'SQL Server'] },
    { href: '/portfolio/web', img: '/images/web1.png', alt: 'Tampilan website hasil pengembangan',
      title: 'Programmer Web',
      text: 'Website dan backend dengan Laravel, Node.js, dan Flask (Python).',
      stack: ['Laravel', 'Node.js', 'Flask', 'MySQL', 'PostgreSQL', 'SQL Server'] },
    { href: '/portfolio/devops', img: '/images/docker1.png', alt: 'Terminal Docker saat menjalankan container',
      title: 'DevOps',
      text: 'Container aplikasi, database, dan jaringan di dalam Docker.',
      stack: ['Docker', 'Docker Compose'] },
    { href: '/portfolio/itsupport', img: '/images/IT-Support1.png', alt: 'Pemasangan server dan jaringan di lapangan',
      title: 'IT Support & Networking',
      text: 'Instalasi CCTV, infrastruktur server, dan jaringan untuk rumah sakit dan perusahaan.',
      stack: ['CCTV', 'Server', 'Networking', 'SIMRS'] },
    { href: '/portfolio/4', img: '/images/Jasa_freelance1.png', alt: 'Proses troubleshoot dan deploy aplikasi ke hosting',
      title: 'Jasa Teknis: Support & Deploy ke Hosting',
      text: 'Troubleshoot dan deploy aplikasi web ke hosting, termasuk aplikasi Flask.',
      stack: ['Flask (Python)', 'cPanel', 'Database'] }
  ];
  const stack = ['Flutter', 'Firebase', 'Laravel', 'Node.js', 'Flask', 'Docker', 'PostgreSQL', 'MySQL', 'SQL Server', 'Cisco', 'Mikrotik', 'CCTV'];
%>

<!-- ===== Hero ===== -->
<section class="hero">
  <div class="wrap">
    <div class="hero-grid">
      <div>
        <h1>Muhamad Afifudin Yusup</h1>
        <p class="hero-role">Developer dan IT specialist</p>
        <p class="hero-lead">
          Saya membuat aplikasi mobile dan web, menjalankan sistem di Docker, serta memasang jaringan, server, dan CCTV
          untuk rumah sakit dan perusahaan.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="https://wa.me/6289638243059" target="_blank" rel="noopener"><i class="fab fa-whatsapp" aria-hidden="true"></i> Chat via WhatsApp</a>
          <a class="btn btn-ghost" href="/CV_My Portofolio Afif_IT.pdf" download="CV_My Portofolio Afif_IT.pdf"><i class="fas fa-download" aria-hidden="true"></i> Unduh CV</a>
        </div>
        <div class="socials">
          <a href="https://www.linkedin.com/in/afif-dev-b8b05a15a" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="fab fa-linkedin-in" aria-hidden="true"></i></a>
          <a href="https://github.com/afiffudin" target="_blank" rel="noopener" aria-label="GitHub"><i class="fab fa-github" aria-hidden="true"></i></a>
          <a href="https://gitlab.com/afiffudin" target="_blank" rel="noopener" aria-label="GitLab"><i class="fab fa-gitlab" aria-hidden="true"></i></a>
        </div>
      </div>

      <!-- Patch panel: tiap port membuka satu bidang keahlian -->
      <nav class="rack" aria-label="Bidang keahlian">
        <div class="rack-bar">
          <span>Pilih bidang keahlian</span>
          <span class="rack-screws" aria-hidden="true"><i></i><i></i></span>
        </div>
        <div class="ports">
          <a class="port" href="/portfolio/programming-mobile">
            <div class="port-top"><span class="socket" aria-hidden="true"></span><span class="led" aria-hidden="true"></span></div>
            <strong>Mobile</strong><span>Flutter, Firebase</span>
          </a>
          <a class="port" href="/portfolio/web">
            <div class="port-top"><span class="socket" aria-hidden="true"></span><span class="led" aria-hidden="true"></span></div>
            <strong>Web</strong><span>Laravel, Node.js, Flask</span>
          </a>
          <a class="port" href="/portfolio/devops">
            <div class="port-top"><span class="socket" aria-hidden="true"></span><span class="led" aria-hidden="true"></span></div>
            <strong>DevOps</strong><span>Docker</span>
          </a>
          <a class="port" href="/portfolio/itsupport">
            <div class="port-top"><span class="socket" aria-hidden="true"></span><span class="led" aria-hidden="true"></span></div>
            <strong>IT Support</strong><span>Jaringan, server, CCTV</span>
          </a>
        </div>
      </nav>
    </div>

    <div class="stack-strip">
      <ul aria-label="Teknologi yang dipakai">
        <% stack.forEach(s => { %><li><%= s %></li><% }) %>
      </ul>
    </div>
  </div>
</section>

<!-- ===== Keahlian / Portfolio ===== -->
<section id="keahlian" class="section" style="padding-top:clamp(2rem,4vw,3rem)">
  <div class="wrap">
    <div class="section-head">
      <h2>Keahlian dan proyek</h2>
      <p>Pilih salah satu untuk melihat screenshot dan detail pekerjaannya.</p>
    </div>
    <div class="works">
      <% works.forEach(w => { %>
        <a class="work" href="<%= w.href %>">
          <div class="work-img"><img src="<%= w.img %>" alt="<%= w.alt %>" loading="lazy" decoding="async" /></div>
          <div>
            <h3><%= w.title %></h3>
            <p><%= w.text %></p>
            <ul class="chips">
              <% w.stack.forEach(s => { %><li><%= s %></li><% }) %>
            </ul>
          </div>
          <span class="work-go" aria-hidden="true"><i class="fas fa-arrow-right"></i></span>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- ===== Pengalaman ===== -->
<section id="pengalaman" class="section about">
  <div class="wrap">
    <div class="section-head">
      <h2>Deskripsi profesional dan pengalaman</h2>
    </div>
    <dl class="facts">
      <div>
        <dt>IT Support, CCTV, dan jaringan</dt>
        <dd>Berpengalaman dalam IT Support, instalasi CCTV, dan networking (crimping RJ45, splicing fiber optic) serta konfigurasi menggunakan Cisco.</dd>
      </div>
      <div>
        <dt>Aplikasi mobile</dt>
        <dd>Pengembangan aplikasi mobile dengan Flutter.</dd>
      </div>
      <div>
        <dt>Docker</dt>
        <dd>Membuat container aplikasi, database, dan jaringan di dalam Docker.</dd>
      </div>
      <div>
        <dt>SIMRS</dt>
        <dd>Implementasi sistem dan pengujian sistem (SIMRS).</dd>
      </div>
    </dl>
  </div>
</section>

<!-- ===== Testimoni (diisi oleh /js/feedback-display.js) ===== -->
<section id="testimoni" class="section">
  <div class="wrap">
    <div class="section-head">
      <h2>Testimoni dan penilaian</h2>
      <p>Penilaian dari rekan kerja dan klien yang pernah saya bantu.</p>
    </div>
    <div id="feedbackList" class="quotes">
      <p class="empty">Memuat testimoni…</p>
    </div>
    <div class="section-cta">
      <a href="/feedback" class="btn btn-ghost">Tulis penilaian</a>
    </div>
  </div>
</section>

<!-- ===== Kontak ===== -->
<section id="contact" class="section contact">
  <div class="wrap contact-grid">
    <div>
      <h2>Punya proyek atau butuh bantuan teknis?</h2>
      <p class="lead">Kirim pesan lewat form ini, atau hubungi langsung lewat WhatsApp untuk respons yang lebih cepat.</p>
      <ul class="contact-links">
        <li><a href="https://wa.me/62895629273504" target="_blank" rel="noopener"><i class="fab fa-whatsapp" aria-hidden="true"></i> WhatsApp</a></li>
        <li><a href="https://www.linkedin.com/in/afif-dev-b8b05a15a" target="_blank" rel="noopener"><i class="fab fa-linkedin-in" aria-hidden="true"></i> LinkedIn</a></li>
        <li><a href="https://github.com/afiffudin" target="_blank" rel="noopener"><i class="fab fa-github" aria-hidden="true"></i> GitHub</a></li>
        <li><a href="https://gitlab.com/afiffudin" target="_blank" rel="noopener"><i class="fab fa-gitlab" aria-hidden="true"></i> GitLab</a></li>
      </ul>
    </div>

    <form action="/contact" method="post" class="form">
      <label class="field"><span>Nama</span>
        <input required type="text" name="name" class="input" placeholder="Nama Anda" autocomplete="name" />
      </label>
      <label class="field"><span>Email</span>
        <input required type="email" name="email" class="input" placeholder="email@domain.com" autocomplete="email" />
      </label>
      <label class="field"><span>Pesan</span>
        <textarea required name="message" rows="5" class="input" placeholder="Ceritakan kebutuhan Anda"></textarea>
      </label>
      <div><button type="submit" class="btn btn-primary">Kirim pesan</button></div>
    </form>
  </div>
</section>

<script src="/js/feedback-display.js"></script>