<!doctype html>
<html lang="id" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= typeof title !== 'undefined' && title ? title + ' — ' : '' %>Muhamad Afifudin Yusup · IT Systems &amp; Infrastructure Specialist</title>
  <meta name="description" content="Portfolio Muhamad Afifudin Yusup, IT Systems &amp; Infrastructure Specialist: dukungan aplikasi enterprise (HRIS, SIMRS), infrastruktur dan jaringan, Docker, serta pengembangan web dan mobile." />

  <!-- Terapkan tema sebelum halaman tampil agar tidak berkedip -->
  <script>
    document.documentElement.classList.add('js');   // <-- BARIS BARU
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    })();
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <a class="skip" href="#main">Langsung ke konten</a>
  <%- include('partials/navbar') %>

  <main id="main">
    <%- body %>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
  <script src="/js/fx.js"></script>
</body>
</body>
</html>