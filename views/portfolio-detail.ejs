<section class="wrap" style="padding-bottom:clamp(3rem,7vw,5rem)">
  <a href="/#keahlian" class="back"><i class="fas fa-arrow-left" aria-hidden="true"></i> Kembali ke portfolio</a>
  <div class="detail-head">
    <div>
      <h1><%= project.title %></h1>
      <% if (project.description) { %><p class="lead" style="margin-top:1rem"><%= project.description %></p><% } %>
      <% if (project.extra) { %><p class="lead" style="margin-top:.75rem"><%= project.extra %></p><% } %>
    </div>
  </div>
  <div class="gallery" style="grid-template-columns:minmax(0,46rem)">
    <div class="shot" style="cursor:default;aspect-ratio:auto"><img src="<%= project.image %>" alt="<%= project.title %>" style="height:auto" loading="lazy"></div>
  </div>
</section>