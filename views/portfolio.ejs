<section id="portfolio" class="section">
  <div class="wrap">
    <div class="section-head"><h2>Portfolio</h2></div>
    <div class="works">
      <% portfolios.forEach(project => { %>
        <a href="/portfolio/<%= project.id %>" class="work">
          <div class="work-img"><img src="<%= project.image %>" alt="<%= project.title %>" loading="lazy" decoding="async"></div>
          <div>
            <h3><%= project.title %></h3>
            <% if (project.description) { %><p><%= project.description %></p><% } %>
          </div>
          <span class="work-go" aria-hidden="true"><i class="fas fa-arrow-right"></i></span>
        </a>
      <% }) %>
    </div>
  </div>
</section>